[Unit]
Description=Proshop scanner every 15 minutes

[Timer]
OnBootSec=9min
# Measure the gap from the END of the previous pass only.
#
# OnUnitActiveSec was removed 2026-09-21 because systemd arms both conditions
# and fires whichever elapses first. Counting from the start shortened the
# recovery gap as passes grew, while a measured refusal persisted for at least
# 10.5 minutes of complete silence.
#
# A separate 2026-09-22 experiment found the binding in-pass limit: contacts
# 1..12 returned 200 and contact 13 returned 429 at 2.5s cadence. Runtime code
# caps every contact at 12; this timer preserves a full 15-minute rest after
# each pass and must not be shortened merely because passes are now smaller.
OnUnitInactiveSec=15min
RandomizedDelaySec=90
AccuracySec=30s

[Install]
WantedBy=timers.target
