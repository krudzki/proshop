[Unit]
Description=Proshop proxy scan every 15 minutes (B)
# Re-enabled 2026-09-25 after being parked 2026-09-21. The reasons for parking
# no longer hold, measured rather than assumed:
#
#   * The proxy works again. The 2026-09-21 cycles showed products_seen=0 and
#     listing_fetch_errors=40 because the DataImpulse account was exhausted.
#     On 2026-09-25 a fresh PL session served proshop.pl with HTTP 200.
#   * The plain lane can no longer keep the catalogue fresh alone. Since
#     2026-09-22 every cycle is capped at 12 contacts: the shop returns 429 on
#     the 13th request in a burst from one address. Over the last 24 h the plain
#     lane fetched 8-12 listing pages per cycle across 81 cycles, which is about
#     1,000 pages a day against 2,480 listing pages. That is a lap of roughly
#     2.5 days.
#
# Both lanes run `python -m proshop.scanner` against the same least-recently-
# checked queue, so the proxy lane adds throughput and does not duplicate a
# cursor. The burst limit applies per address and this lane draws a fresh
# residential identity every cycle. The scanner's hourly guard (160 listing
# pages) is shared by both lanes because they record cycles under one store.
#
# To park it again: disable the timer AND remove its line from
# serwer-minipc/systemd/enabled.txt, or the fleet installer re-enables it.

[Timer]
OnBootSec=12min
OnUnitActiveSec=15min
OnUnitInactiveSec=15min
RandomizedDelaySec=90
AccuracySec=30s

[Install]
WantedBy=timers.target
